# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# Use the PUBLISHABLE key here, never the secret one: this value ships to the
# browser. Row Level Security is what protects the data.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxx

# ---------------------------------------------------------------------------
# Submission notifications (optional)
# Leave RESEND_API_KEY empty to turn emails off — submitting still works and
# the answers are always saved to the database.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
NOTIFY_EMAIL_TO=med@intelligentb2b.com
NOTIFY_EMAIL_FROM=onboarding@yourdomain.com
